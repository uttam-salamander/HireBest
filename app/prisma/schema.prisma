generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Authentication & Users
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  avatarUrl     String?
  role          Role      @default(CANDIDATE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  recruiter     Recruiter?
  candidate     Candidate?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

// =============================================================================
// Organization & Recruiters
// =============================================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  recruiters Recruiter[]
  jobs       Job[]
  templates  AssessmentTemplate[]
}

model Recruiter {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String
  createdAt DateTime @default(now())

  // Relations
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id])
  jobs      Job[]
  templates AssessmentTemplate[]
}

// =============================================================================
// Candidates
// =============================================================================

model Candidate {
  id        String   @id @default(cuid())
  userId    String?  @unique
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  // Relations
  user        User?                 @relation(fields: [userId], references: [id])
  invitations AssessmentInvitation[]
  sessions    AssessmentSession[]
  results     AssessmentResult[]
}

// =============================================================================
// Jobs
// =============================================================================

model Job {
  id          String    @id @default(cuid())
  companyId   String
  recruiterId String
  templateId  String?
  title       String
  description String?   @db.Text
  status      JobStatus @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  company     Company              @relation(fields: [companyId], references: [id])
  recruiter   Recruiter            @relation(fields: [recruiterId], references: [id])
  template    AssessmentTemplate?  @relation(fields: [templateId], references: [id])
  invitations AssessmentInvitation[]
  results     AssessmentResult[]
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
}

// =============================================================================
// Assessment Templates
// =============================================================================

model AssessmentTemplate {
  id            String   @id @default(cuid())
  companyId     String
  createdById   String
  name          String
  description   String?  @db.Text
  questionCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  company   Company           @relation(fields: [companyId], references: [id])
  createdBy Recruiter         @relation(fields: [createdById], references: [id])
  questions TemplateQuestion[]
  jobs      Job[]
}

model TemplateQuestion {
  id            String   @id @default(cuid())
  templateId    String
  orderIndex    Int
  questionText  String   @db.Text
  scoringRubric String?  @db.Text
  createdAt     DateTime @default(now())

  // Relations
  template  AssessmentTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses QuestionResponse[]

  @@unique([templateId, orderIndex])
}

// =============================================================================
// Assessment Invitations & Sessions
// =============================================================================

model AssessmentInvitation {
  id             String           @id @default(cuid())
  jobId          String
  candidateId    String
  token          String           @unique
  candidateEmail String
  status         InvitationStatus @default(SENT)
  sentAt         DateTime         @default(now())
  expiresAt      DateTime
  openedAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  // Relations
  job       Job                @relation(fields: [jobId], references: [id])
  candidate Candidate          @relation(fields: [candidateId], references: [id])
  session   AssessmentSession?
}

enum InvitationStatus {
  SENT
  OPENED
  STARTED
  COMPLETED
  EXPIRED
}

model AssessmentSession {
  id              String        @id @default(cuid())
  invitationId    String        @unique
  candidateId     String
  currentQuestion Int           @default(0)
  status          SessionStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  lastActivityAt  DateTime      @default(now())
  completedAt     DateTime?

  // Relations
  invitation AssessmentInvitation @relation(fields: [invitationId], references: [id])
  candidate  Candidate            @relation(fields: [candidateId], references: [id])
  responses  QuestionResponse[]
  result     AssessmentResult?
  messages   ChatMessage[]
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  EXPIRED
}

// =============================================================================
// Responses & Results
// =============================================================================

model QuestionResponse {
  id            String   @id @default(cuid())
  sessionId     String
  questionId    String
  questionOrder Int
  responseText  String   @db.Text
  score         Int?
  aiRationale   String?  @db.Text
  submittedAt   DateTime @default(now())
  scoredAt      DateTime?

  // Relations
  session  AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question TemplateQuestion  @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String      @db.Text
  timestamp DateTime    @default(now())

  // Relations
  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum MessageRole {
  AI
  CANDIDATE
}

model AssessmentResult {
  id                    String   @id @default(cuid())
  sessionId             String   @unique
  candidateId           String
  jobId                 String
  overallScore          Int
  summary               String?  @db.Text
  strengths             String?  @db.Text
  areasForImprovement   String?  @db.Text
  durationSeconds       Int?
  createdAt             DateTime @default(now())

  // Relations
  session   AssessmentSession @relation(fields: [sessionId], references: [id])
  candidate Candidate         @relation(fields: [candidateId], references: [id])
  job       Job               @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([overallScore])
  @@index([createdAt])
}
